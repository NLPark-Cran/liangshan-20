2026.crina.at {
	root * /srv/sites/2026.crina.at
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API 反代到后端
	handle /api/* {
		reverse_proxy 127.0.0.1:8902 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# HTML 不缓存，改完立刻生效
	@html path *.html /
	header @html Cache-Control "no-cache, must-revalidate"

	# JS 与 CSS 用 ETag 协商，避免模块更新后继续命中一周旧缓存
	@static_assets path_regexp \.(css|js|mjs|png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|mp3|mp4|webm|wasm|glb)$
	header @static_assets Cache-Control "public, max-age=0, must-revalidate"

	# JSON 数据不缓存，避免更新后前端拿到旧数据
	@json_data path_regexp \.(json)$
	header @json_data Cache-Control "no-cache, must-revalidate"

	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
